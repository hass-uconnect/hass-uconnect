                    "ssdp_send_sms": "Configurer les commandes à distance maintenant (envoie un SMS)",
                    "ssdp_finish": "Terminer sans commandes à distance"
                }
            },
            "ssdp_send_sms": {
                "title": "Commandes à distance",
                "description": "Le SMS n'a pas pu être envoyé. Validez pour réessayer."
            },
            "ssdp_enroll": {
                "title": "Commandes à distance",
